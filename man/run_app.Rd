\name{run_app}
\alias{run_app}
\title{Start Advanced Research Analytics}
\usage{run_app(launch.browser = interactive(), port = NULL, host = "127.0.0.1")}
\arguments{\item{launch.browser}{Open the browser automatically.}\item{port}{Local port or NULL.}\item{host}{Local interface, by default loopback.}}
\description{Launches the Shiny application bundled in this package.}
\examples{\dontrun{AdvancedResearchAnalytics::run_app()}}
